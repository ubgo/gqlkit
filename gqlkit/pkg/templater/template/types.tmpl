// {{ .ValueName }} holds one {{ .Name }} result, decoded into its concrete type
// by the __typename the {{ .Name }}Fields selector always requests.
//
// Value is the concrete *T (type-switch on it), or nil when the result was
// null or its __typename is not a type this SDK knows — a newer server may add
// members. Typename and Raw always keep what the server sent, so unknown
// members are never lost.
type {{ .ValueName }} struct {
	Typename string
	Value    {{ .Name }}
	Raw      json.RawMessage
}

// UnmarshalJSON dispatches on __typename; it never fails on an unknown one.
func (v *{{ .ValueName }}) UnmarshalJSON(data []byte) error {
	*v = {{ .ValueName }}{}
	if string(data) == "null" {
		return nil
	}
	var probe struct {
		Typename string `json:"__typename"`
	}
	if err := json.Unmarshal(data, &probe); err != nil {
		return err
	}
	v.Typename = probe.Typename
	v.Raw = append(json.RawMessage(nil), data...)
	switch probe.Typename {
{{- range .PossibleTypes }}
	case "{{ .TypeName }}":
		x := new({{ .GoName }})
		if err := json.Unmarshal(data, x); err != nil {
			return err
		}
		v.Value = x
{{- end }}
	}
	return nil
}

// MarshalJSON re-encodes the original JSON when present (lossless round
// trip), else the concrete value, else null.
func (v {{ .ValueName }}) MarshalJSON() ([]byte, error) {
	if v.Raw != nil {
		return v.Raw, nil
	}
	if v.Value != nil {
		return json.Marshal(v.Value)
	}
	return []byte("null"), nil
}
